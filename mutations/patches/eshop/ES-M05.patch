diff --git a/src/WebhookClient/IntegrationEvents/ESM05OrderStatusSubscription.cs b/src/WebhookClient/IntegrationEvents/ESM05OrderStatusSubscription.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c711edf4111871d859c1a0835ed6c2809851a431
--- /dev/null
+++ b/src/WebhookClient/IntegrationEvents/ESM05OrderStatusSubscription.cs
@@ -0,0 +1,51 @@
+using System.Diagnostics;
+using eShop.EventBus.Abstractions;
+using eShop.EventBus.Events;
+
+namespace eShop.WebhookClient.IntegrationEvents;
+
+public sealed record OrderStatusChangedToSubmittedIntegrationEvent
+    : IntegrationEvent
+{
+    public OrderStatusChangedToSubmittedIntegrationEvent()
+    {
+    }
+}
+
+public sealed class ESM05OrderStatusChangedToSubmittedIntegrationEventHandler(
+    ILogger<ESM05OrderStatusChangedToSubmittedIntegrationEventHandler> logger)
+    : IIntegrationEventHandler<
+        OrderStatusChangedToSubmittedIntegrationEvent>
+{
+    public Task Handle(
+        OrderStatusChangedToSubmittedIntegrationEvent @event)
+    {
+        var activity = Activity.Current;
+
+        if (activity is not null)
+        {
+            activity.SetTag(
+                "messaging.system",
+                "rabbitmq");
+
+            activity.SetTag(
+                "messaging.operation.type",
+                "receive");
+
+            activity.SetTag(
+                "messaging.operation.name",
+                "receive");
+
+            activity.SetTag(
+                "server.address",
+                "eventbus");
+        }
+
+        logger.LogInformation(
+            "ES-M05 observed submitted order event "
+            + "{IntegrationEventId}",
+            @event.Id);
+
+        return Task.CompletedTask;
+    }
+}
