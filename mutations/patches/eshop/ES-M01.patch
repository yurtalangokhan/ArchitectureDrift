+    private static HttpClient CreateESM01CatalogClient()
+    {
+        var handler = new SocketsHttpHandler
+        {
+            ConnectCallback = static async (
+                _,
+                cancellationToken) =>
+            {
+                var socket = new Socket(
+                    SocketType.Stream,
+                    ProtocolType.Tcp);
+
+                try
+                {
+                    await socket.ConnectAsync(
+                        IPAddress.Loopback,
+                        ESM01CatalogPort,
+                        cancellationToken);
+
+                    return new NetworkStream(
+                        socket,
+                        ownsSocket: true);
+                }
+                catch
+                {
+                    socket.Dispose();
+                    throw;
+                }
+            }
+        };
+
+        return new HttpClient(handler)
+        {
+            BaseAddress = new Uri(
+                "http://catalog-api")
+        };
+    }
+
+    private async Task InvokeESM01CatalogAsync(
+        CancellationToken cancellationToken)
+    {
+        try
+        {
+            using var response =
+                await ESM01CatalogClient.GetAsync(
+                    "/alive",
+                    cancellationToken);
+
+            response.EnsureSuccessStatusCode();
+        }
+        catch (Exception exception)
+        {
+            logger.LogWarning(
+                exception,
+                "ES-M01 catalog mutation call failed");
+        }
+    }
+
