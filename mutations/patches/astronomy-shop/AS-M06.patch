+type asM06ConsumerGroupHandler struct {
+	tracer     trace.Tracer
+	brokerHost string
+}
+
+func (h *asM06ConsumerGroupHandler) Setup(
+	sarama.ConsumerGroupSession,
+) error {
+	return nil
+}
+
+func (h *asM06ConsumerGroupHandler) Cleanup(
+	sarama.ConsumerGroupSession,
+) error {
+	return nil
+}
+
+func (h *asM06ConsumerGroupHandler) ConsumeClaim(
+	session sarama.ConsumerGroupSession,
+	claim sarama.ConsumerGroupClaim,
+) error {
+	for {
+		select {
+		case <-session.Context().Done():
+			return nil
+
+		case message, ok := <-claim.Messages():
+			if !ok {
+				return nil
+			}
+
+			_, span := h.tracer.Start(
+				session.Context(),
+				"AS-M06 kafka receive",
+				trace.WithSpanKind(
+					trace.SpanKindConsumer,
+				),
+			)
+
+			span.SetAttributes(
+				attribute.String(
+					"messaging.system",
+					"kafka",
+				),
+				attribute.String(
+					"messaging.operation.type",
+					"receive",
+				),
+				attribute.String(
+					"messaging.operation.name",
+					"receive",
+				),
+				attribute.String(
+					"messaging.destination.name",
+					message.Topic,
+				),
+				attribute.String(
+					"server.address",
+					h.brokerHost,
+				),
+			)
+
+			span.End()
+
+			session.MarkMessage(
+				message,
+				"AS-M06 architecture mutation observation",
+			)
+		}
+	}
+}
+
+func asM06BrokerHost(
+	brokerAddress string,
+) string {
+	host, _, err := net.SplitHostPort(
+		brokerAddress,
+	)
+
+	if err == nil && host != "" {
+		return host
+	}
+
+	return brokerAddress
+}
+
+func startASMutationKafkaConsumer(
+	ctx context.Context,
+	brokerAddress string,
+	topic string,
+	logger *slog.Logger,
+	tracer trace.Tracer,
+) (func() error, error) {
+	config := sarama.NewConfig()
+
+	config.Version = sarama.V3_0_0_0
+	config.Consumer.Offsets.Initial = sarama.OffsetNewest
+
+	group, err := sarama.NewConsumerGroup(
+		[]string{
+			brokerAddress,
+		},
+		"checkout-as-m06",
+		config,
+	)
+	if err != nil {
+		return nil, err
+	}
+
+	handler := &asM06ConsumerGroupHandler{
+		tracer: tracer,
+		brokerHost: asM06BrokerHost(
+			brokerAddress,
+		),
+	}
+
+	go func() {
+		for ctx.Err() == nil {
+			err := group.Consume(
+				ctx,
+				[]string{
+					topic,
+				},
+				handler,
+			)
+
+			if ctx.Err() != nil {
+				return
+			}
+
+			if err != nil {
+				logger.Warn(
+					"AS-M06 Kafka consumer session failed",
+					slog.Any(
+						"error",
+						err,
+					),
+				)
+
+				timer := time.NewTimer(
+					time.Second,
+				)
+
+				select {
+				case <-ctx.Done():
+					if !timer.Stop() {
+						<-timer.C
+					}
+
+					return
+
+				case <-timer.C:
+				}
+			}
+		}
+	}()
+
+	return group.Close, nil
+}
