+func (cs *checkout) invokeASMutationRecommendation(
+	ctx context.Context,
+	userID string,
+	items []*pb.CartItem,
+) {
+	productIDs := make(
+		[]string,
+		0,
+		len(items),
+	)
+
+	for _, item := range items {
+		productIDs = append(
+			productIDs,
+			item.GetProductId(),
+		)
+	}
+
+	mutationCtx, cancel := context.WithTimeout(
+		ctx,
+		asM01RecommendationRequestTimeout,
+	)
+	defer cancel()
+
+	_, err := cs.recommendationSvcClient.ListRecommendations(
+		mutationCtx,
+		&pb.ListRecommendationsRequest{
+			UserId:     userID,
+			ProductIds: productIDs,
+		},
+	)
+
+	if err != nil {
+		logger.Warn(
+			"AS-M01 recommendation mutation call failed",
+			slog.Any(
+				"error",
+				err,
+			),
+		)
+	}
